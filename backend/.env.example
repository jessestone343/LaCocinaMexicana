# Export these variables before running the binary; it does not load .env files.
LISTEN_ADDR=0.0.0.0:3000
DASHBOARD_ORIGIN=https://dashboard.lacocinamexicana.net
COOKIE_SECURE=true
DATA_DIR=/data
STATIC_DIR=/app/dist
# Server-side Google Places API (New), also used by /api/google-reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_LIMIT=3
BOOTSTRAP_USERNAME=jesse.stone.truecore.services
# First start only. Supply a unique secret of at least 12 characters.
# Prefer a mounted secret file; do not commit the file or the password.
BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
